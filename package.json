{
  "name": "frameweave",
  "displayName": "Frameweave",
  "description": "Visually understand and shape your framework's UI.",
  "version": "0.0.1",
  "publisher": "Killer88967",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "visual",
    "framework",
    "components",
    "react",
    "nextjs",
    "tailwindcss"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Killer88967/frameweave.git"
  },
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "frameweave.open",
        "title": "Open Frameweave",
        "category": "Frameweave"
      },
      {
        "command": "frameweave.refreshProjectProfile",
        "title": "Refresh Project Profile",
        "category": "Frameweave",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "frameweave",
          "title": "Frameweave",
          "icon": "media//frameweave.svg"
        }
      ]
    },
    "views": {
      "frameweave": [
        {
          "id": "frameweave.projectProfile",
          "name": "Project Profile",
          "icon": "media/project-profile.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "frameweave.refreshProjectProfile",
          "when": "view == frameweave.projectProfile",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "pnpm check && node esbuild.mjs",
    "watch": "concurrently --kill-others --names types,build \"tsc --noEmit --watch --preserveWatchOutput\" \"node esbuild.mjs --watch\"",
    "check": "tsc --noEmit",
    "package": "pnpm build && vsce package --out frameweave.vsix",
    "install:local": "pnpm package && code --install-extension frameweave.vsix --force"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.100.0",
    "concurrently": "latest",
    "esbuild": "latest",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "latest"
  }
}
